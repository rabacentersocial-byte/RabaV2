# Brotli Compression (High-performance compression for CSS, JS, SVG, and HTML)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# LiteSpeed Server Compression & Cache Engine
<IfModule LiteSpeed>
  CacheEngine on
  enableBrotli on
  enableGzip on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow explicitly designated static root files & well-known directories directly
  RewriteRule ^(robots\.txt|sitemap\.xml|llms\.txt|favicon\.ico|favicon\.svg|manifest\.webmanifest|manifest\.json|404\.html)$ - [L]
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^(assets|images|logo|uploads|data|specialists)/ - [L]

  # 2. Allow existing physical files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Agent Content Negotiation: Serve Markdown (llms.txt) ONLY for valid routes (including root /)
  RewriteCond %{HTTP:Accept} text/(x-)?markdown [NC,OR]
  RewriteCond %{HTTP:Accept} application/markdown [NC,OR]
  RewriteCond %{QUERY_STRING} (format=markdown|format=md|alt=markdown) [NC]
  RewriteCond %{REQUEST_URI} ^/((about|contact|terms|terms-of-service|privacy|privacy-policy|services|services-directory|specialists|specialists-directory|branches|branches-directory|offers|offers-directory|blog|blog-directory|articles|booking|admin|login)/?|(blog|articles|specialist)/.+/?|index\.html)?$ [NC]
  RewriteRule ^ /llms.txt [L]

  # 4. Rewrite ONLY valid SPA routes to /index.html with HTTP 200
  RewriteRule ^(about|contact|terms|terms-of-service|privacy|privacy-policy)/?$ /index.html [L,QSA]
  RewriteRule ^(services|services-directory|specialists|specialists-directory|branches|branches-directory|offers|offers-directory)/?$ /index.html [L,QSA]
  RewriteRule ^(blog|blog-directory|articles|booking|admin|login)/?$ /index.html [L,QSA]
  RewriteRule ^(blog|articles|specialist)/.+/?$ /index.html [L,QSA]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^$ /index.html [L]

  # 5. Non-existent URLs: Strictly return real HTTP 404 status (Agents require 404 or 410, never 200)
  RewriteRule ^ - [R=404,L]
</IfModule>

# Ensure llms.txt is strictly served with text/markdown Content-Type and Vary: Accept
<Files "llms.txt">
  ForceType "text/markdown; charset=utf-8"
  <IfModule mod_headers.c>
    Header set Content-Type "text/markdown; charset=utf-8"
    Header set Vary "Accept, Accept-Encoding"
    Header set Link '</llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"'
  </IfModule>
</Files>

# Caching Configuration for High Performance (Resolves PageSpeed "Use efficient cache lifetimes")
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Critical for Agent Content Negotiation and CDN caching: never cache HTML for Markdown or vice-versa
  Header always merge Vary "Accept, Accept-Encoding"
  Header always set Link '</llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"'

  # Enforce 1-year immutable caching on all static assets regardless of MIME detection
  <FilesMatch "\.(js|mjs|css|webp|png|jpg|jpeg|svg|gif|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages revalidate immediately & advertise Agent resources via RFC 8288 Link headers
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Link '</llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"'
    Header set Vary "Accept, Accept-Encoding"
  </FilesMatch>

  # Error Document for missing pages
  ErrorDocument 404 /404.html

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
