# APP_URL: Public URL where this application is hosted (auto-injected in Cloud Run).
# For custom domain production deployments, set to https://rabacenters.com
APP_URL="https://rabacenters.com"

# ADMIN_SESSION_SECRET: Secret key (32+ chars) used to HMAC-sign admin API session tokens.
# If omitted, the server generates an ephemeral random key per process (sessions reset on restart).
ADMIN_SESSION_SECRET=""

# OPTIONAL SUPER ADMIN OVERRIDE (Server-Side Only - NEVER prefix with VITE_)
# If set, grants emergency/primary Super Admin login with these credentials on /api/admin/login.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# CLOUD SQL (PostgreSQL): Managed relational database connection (Backend - Node.js server.ts)
SQL_HOST="your-cloud-sql-host"
SQL_USER="your-cloud-sql-user"
SQL_PASSWORD="your-cloud-sql-password"
SQL_DB_NAME="your-cloud-sql-database"

# FIREBASE CLIENT (Optional Overrides - Frontend Vite)
# By default, client Firebase configuration is loaded from firebase-applet-config.json.
# Set these only if overriding the bundled Firebase project in a separate staging/prod environment.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# FIREBASE ADMIN SDK (Optional - Backend Node.js server.ts)
# Required only when deploying outside Google-hosted Starter Tier and minting custom tokens server-side.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID=""

# MOYASAR ONLINE PAYMENTS (Server-Side Secrets - NEVER prefix with VITE_)
# Recommended for production instead of storing secrets in client-accessible env vars.
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

