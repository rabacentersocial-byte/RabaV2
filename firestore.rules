rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Primitives & Helpers ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // --- Entity Validation Helpers ---
    function isValidAppointment(data) {
      return (data.patientName is string || data.parentName is string)
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 35
        && data.date is string && data.date.size() <= 50
        && data.status is string && (data.status in ['new', 'pending', 'confirmed', 'completed', 'cancelled']);
    }

    function isValidTestimonial(data) {
      return data.parentName is string && data.parentName.size() > 0 && data.parentName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1500;
    }

    // --- Collection Rule Blocks ---

    // 1. Dynamic Site Settings (Public Read for Visitors, Authenticated Admin Write)
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingId);
    }

    // 2. Specialists Directory (Public Read for Visitors, Authenticated Admin Write)
    match /specialists/{specialistId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(specialistId);
    }

    // 3. Appointments & Consultation Bookings (Public Create for Patients, Authenticated Admin Read/Update/Delete)
    match /appointments/{appointmentId} {
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming());
      allow read, update, delete: if isSignedIn();
    }

    // 4. Parent Reviews and Testimonials (Public Read, Public Create with Validation, Admin Update/Delete)
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidId(testimonialId) && isValidTestimonial(incoming());
      allow update, delete: if isSignedIn() && isValidId(testimonialId);
    }

    // 5. Clinical & Educational Blog Posts (Public Read, Admin Write)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(postId);
    }

    // 6. System Notifications (Authenticated Admin Read & Write)
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && isValidId(notificationId);
    }

    // 7. Admin User Access Control (Authenticated Admin Read & Write)
    match /admins/{adminId} {
      allow read, write: if isSignedIn() && isValidId(adminId);
    }

    // 8. Public Customer Requests & Inquiries
    match /customer_requests/{requestId} {
      allow create: if isValidId(requestId);
      allow read, update, delete: if isSignedIn();
    }

    // 9. User Profiles & Accounts
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 10. Connection Test Document
    match /test/connection {
      allow get: if true;
    }
  }
}
