{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Unified customer booking, course registration, Sewar shadow teacher request, quick consultation, and store order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referenceNumber": { "type": "string" },
        "type": { "type": "string" },
        "requestType": {
          "type": "string",
          "enum": ["appointment", "package", "course", "shadow_teacher", "national_day_offer", "quick_consultation", "store_order", "newsletter", "contact"]
        },
        "requestSource": { "type": "string" },
        "patientName": { "type": "string", "maxLength": 150 },
        "childName": { "type": "string", "maxLength": 150 },
        "childAge": { "type": "number" },
        "parentName": { "type": "string", "maxLength": 150 },
        "guardianName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "guardianPhone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "guardianEmail": { "type": "string", "maxLength": 120 },
        "serviceId": { "type": "string", "maxLength": 120 },
        "serviceName": { "type": "string", "maxLength": 200 },
        "serviceTitle": { "type": "string", "maxLength": 200 },
        "specialistId": { "type": "string", "maxLength": 120 },
        "specialistName": { "type": "string", "maxLength": 150 },
        "branch": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "qualification": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 80 },
        "timeSlot": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["new", "pending", "contacted", "confirmed", "completed", "cancelled"]
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "readByAdmin": { "type": "boolean" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "couponCode": { "type": "string", "maxLength": 60 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "preferredCallTime": { "type": "string", "maxLength": 100 },
        "assignedToUserId": { "type": "string", "maxLength": 128 },
        "assignedToUserName": { "type": "string", "maxLength": 150 },
        "assignedToUserEmail": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "familyMemberId": { "type": "string", "maxLength": 128 },
        "familyMemberName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" }
      },
      "required": ["patientName", "phone", "date", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Registered family or beneficiary client profile linked to Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fileNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "dob": { "type": "string", "minLength": 4, "maxLength": 30 },
        "familyMembers": { "type": "array" },
        "role": { "type": "string", "enum": ["client"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "adminNotes": { "type": "string", "maxLength": 4000 },
        "suspensionReason": { "type": "string", "maxLength": 1000 },
        "suspendedAt": { "type": "string", "maxLength": 50 },
        "suspendedBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fileNumber", "fullName", "phone", "email", "gender", "dob", "role", "status"]
    },
    "MemberRecord": {
      "title": "MemberRecord",
      "description": "Individual child clinical report or supplementary sub-file attached to a specific family member in a client file",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "familyMemberId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "familyMemberName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "recordCategory": { "type": "string", "enum": ["report", "subfile"] },
        "reportType": {
          "type": "string",
          "enum": [
            "developmental_assessment",
            "aba_progress",
            "speech_therapy",
            "occupational_therapy",
            "iep_plan",
            "medical_file",
            "school_report",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 6000 },
        "recommendations": { "type": "string", "maxLength": 4000 },
        "specialistName": { "type": "string", "maxLength": 150 },
        "reportDate": { "type": "string", "minLength": 4, "maxLength": 30 },
        "fileUrl": { "type": "string", "maxLength": 1000 },
        "fileName": { "type": "string", "maxLength": 250 },
        "authorRole": { "type": "string", "enum": ["admin", "client"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "clientUid",
        "familyMemberId",
        "familyMemberName",
        "recordCategory",
        "reportType",
        "title",
        "summary",
        "reportDate",
        "authorRole",
        "createdByUid"
      ]
    },
    "Specialist": {
      "title": "Specialist",
      "description": "Rehabilitation therapist, psychologist or clinical consultant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "title": { "type": "string" },
        "role": { "type": "string" },
        "category": { "type": "string" },
        "avatar": { "type": "string" },
        "experienceYears": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "bio": { "type": "string" },
        "specialties": { "type": "array" }
      },
      "required": ["id", "name", "title", "role"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Parent review and testimonial for Raba Center services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentName": { "type": "string" },
        "parentNameEn": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "category": { "type": "string" },
        "specialistName": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "avatar": { "type": "string" },
        "isVerifiedParent": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "active": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["parentName", "rating", "comment"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Clinical and educational article for parents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 400 },
        "titleEn": { "type": "string", "maxLength": 400 },
        "slug": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryTitle": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "isSliderFeatured": { "type": "boolean" },
        "order": { "type": "number" },
        "readTimeMinutes": { "type": "number" },
        "publishDate": { "type": "string" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "title", "category"]
    },
    "Service": {
      "title": "Service",
      "description": "Specialized pediatric therapy and rehabilitation service item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 100 },
        "categoryAr": { "type": "string", "maxLength": 150 },
        "categoryEn": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 5000 },
        "descriptionEn": { "type": "string", "maxLength": 5000 },
        "durationMinutes": { "type": "number" },
        "sessionPrice": { "type": "number" },
        "assessmentPrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "showPrice": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "TherapyPackage": {
      "title": "TherapyPackage",
      "description": "Rehabilitation and intensive therapy package",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "nameEn": { "type": "string", "maxLength": 300 },
        "tagline": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "sessionsCount": { "type": "number" },
        "durationWeeks": { "type": "number" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "popular": { "type": "boolean" },
        "isSummer": { "type": "boolean" },
        "active": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Homepage hero slider card or slider display configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "src": { "type": "string", "maxLength": 200000 },
        "titleAr": { "type": "string", "maxLength": 400 },
        "titleEn": { "type": "string", "maxLength": 400 },
        "subtitleAr": { "type": "string", "maxLength": 1000 },
        "subtitleEn": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id"]
    },
    "Course": {
      "title": "Course",
      "description": "Accredited training course or workshop",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "shortTitle": { "type": "string", "maxLength": 150 },
        "hoursCount": { "type": "number" },
        "currentPrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["id"]
    },
    "Accreditation": {
      "title": "Accreditation",
      "description": "International or local clinical accreditation badge",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 40 },
        "nameAr": { "type": "string", "maxLength": 300 },
        "nameEn": { "type": "string", "maxLength": 300 },
        "issuerAr": { "type": "string", "maxLength": 400 },
        "issuerEn": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "maxLength": 80 },
        "verified": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Strategic institutional, government, academic, or healthcare partner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 300 },
        "nameEn": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 200 },
        "sector": { "type": "string", "maxLength": 80 },
        "logoUrl": { "type": "string", "maxLength": 200000 },
        "isActive": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promotional campaign, discount coupon, or free activity offer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "couponCode": { "type": "string", "maxLength": 80 },
        "discountType": { "type": "string", "enum": ["percentage", "free_day", "fixed_amount"] },
        "discountValue": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id"]
    },
    "FinanceRecord": {
      "title": "FinanceRecord",
      "description": "Admin-restricted financial settings, clinic payment configuration, and pricing global policy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "recordType": { "type": "string", "maxLength": 80 },
        "currencySymbol": { "type": "string", "maxLength": 20 },
        "isVatInclusive": { "type": "boolean" },
        "installmentNote": { "type": "string", "maxLength": 500 },
        "clinicName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "workingHours": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 300 },
        "announcement": { "type": "string", "maxLength": 500 }
      },
      "required": ["id"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or booking alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrative user record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "operations_manager", "clinical_supervisor", "receptionist", "accountant", "custom", "admin", "clinical_manager"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "assignedBranches": { "type": "array" },
        "branchScope": { "type": "string", "enum": ["all", "assigned_only", "assigned_and_unassigned"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Dynamic site configuration, module customizer data, public payment config, and page content",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "data": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["data"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Online payment ledger transaction and Arabic VAT invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "gatewayPaymentId": { "type": "string", "maxLength": 150 },
        "invoiceNumber": { "type": "string", "maxLength": 60 },
        "appointmentId": { "type": "string", "maxLength": 128 },
        "referenceNumber": { "type": "string", "maxLength": 80 },
        "clientId": { "type": "string", "maxLength": 128 },
        "fileNumber": { "type": "string", "maxLength": 50 },
        "clientName": { "type": "string", "maxLength": 150 },
        "childName": { "type": "string", "maxLength": 150 },
        "clientPhone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "serviceTitle": { "type": "string", "maxLength": 250 },
        "subtotal": { "type": "number" },
        "vatAmount": { "type": "number" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["SAR"] },
        "provider": { "type": "string", "enum": ["moyasar", "tabby", "tamara", "manual"] },
        "mode": { "type": "string", "enum": ["sandbox", "live"] },
        "method": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "paid", "failed", "refunded", "manual_review"] },
        "receiptUrl": { "type": "string", "maxLength": 200000 },
        "transferReference": { "type": "string", "maxLength": 120 },
        "gatewayMessage": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string", "maxLength": 50 },
        "verifiedAt": { "type": "string" },
        "verifiedAtISO": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoiceNumber", "clientName", "clientPhone", "serviceTitle", "amount", "currency", "provider", "mode", "method", "status"]
    },
    "PaymentSecret": {
      "title": "PaymentSecret",
      "description": "Super-Admin restricted payment gateway secret keys and webhook secrets",
      "type": "object",
      "properties": {
        "secretKey": { "type": "string", "maxLength": 300 },
        "sandboxSecretKey": { "type": "string", "maxLength": 300 },
        "liveSecretKey": { "type": "string", "maxLength": 300 },
        "webhookSecret": { "type": "string", "maxLength": 300 },
        "tabbySecretKey": { "type": "string", "maxLength": 300 },
        "tamaraSecretKey": { "type": "string", "maxLength": 300 },
        "updatedAtISO": { "type": "string", "maxLength": 50 }
      }
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Dynamic site configuration, module customizer data, and page content"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Public clinical and therapy services catalog"
    },
    "/packages/{packageId}": {
      "schema": "TherapyPackage",
      "description": "Public rehabilitation and intensive therapy packages"
    },
    "/sliders/{sliderId}": {
      "schema": "HeroSlide",
      "description": "Homepage hero slider slides and display configuration"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Training courses and workshops catalog"
    },
    "/accreditations/{accreditationId}": {
      "schema": "Accreditation",
      "description": "Official accreditations and quality certifications"
    },
    "/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Strategic success partners and alliances"
    },
    "/offers/{offerId}": {
      "schema": "Offer",
      "description": "Promotional offers, discount coupons, and activities"
    },
    "/finance/{financeId}": {
      "schema": "FinanceRecord",
      "description": "Admin-only financial configuration, payment rules, and pricing policies"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Registered family/client profiles keyed by Firebase Auth UID"
    },
    "/clients/{clientId}/member_records/{recordId}": {
      "schema": "MemberRecord",
      "description": "Subcollection storing separate child clinical reports and sub-files per added family member"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of patient booking requests and appointments"
    },
    "/customer_requests/{requestId}": {
      "schema": "Appointment",
      "description": "Collection of general customer inquiries and newsletter subscriptions"
    },
    "/specialists/{specialistId}": {
      "schema": "Specialist",
      "description": "Collection of certified medical and rehabilitation specialists"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of client reviews and testimonials"
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of educational articles and clinical guides"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of system and appointment notifications"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of administrative users with privileged system access"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentTransaction",
      "description": "Collection of online payments, bank transfer receipts, and Arabic VAT invoices"
    },
    "/payment_secrets/{secretId}": {
      "schema": "PaymentSecret",
      "description": "Strictly Super-Admin restricted payment gateway secret keys and webhook tokens"
    }
  }
}
