{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Unified customer booking, course registration, Sewar shadow teacher request, quick consultation, and store order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referenceNumber": { "type": "string" },
        "type": { "type": "string" },
        "requestType": {
          "type": "string",
          "enum": ["appointment", "package", "course", "shadow_teacher", "national_day_offer", "quick_consultation", "store_order", "newsletter", "contact"]
        },
        "requestSource": { "type": "string" },
        "patientName": { "type": "string", "maxLength": 150 },
        "childName": { "type": "string", "maxLength": 150 },
        "childAge": { "type": "number" },
        "parentName": { "type": "string", "maxLength": 150 },
        "guardianName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "guardianPhone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "guardianEmail": { "type": "string", "maxLength": 120 },
        "serviceId": { "type": "string", "maxLength": 120 },
        "serviceName": { "type": "string", "maxLength": 200 },
        "serviceTitle": { "type": "string", "maxLength": 200 },
        "specialistId": { "type": "string", "maxLength": 120 },
        "specialistName": { "type": "string", "maxLength": 150 },
        "branch": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "qualification": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 80 },
        "timeSlot": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["new", "pending", "contacted", "confirmed", "completed", "cancelled"]
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "readByAdmin": { "type": "boolean" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "couponCode": { "type": "string", "maxLength": 60 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "preferredCallTime": { "type": "string", "maxLength": 100 },
        "assignedToUserId": { "type": "string", "maxLength": 128 },
        "assignedToUserName": { "type": "string", "maxLength": 150 },
        "assignedToUserEmail": { "type": "string", "maxLength": 150 },
        "userId": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "familyMemberId": { "type": "string", "maxLength": 128 },
        "familyMemberName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" }
      },
      "required": ["patientName", "phone", "date", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "Registered family or beneficiary client profile linked to Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fileNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 35 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "dob": { "type": "string", "minLength": 4, "maxLength": 30 },
        "familyMembers": { "type": "array" },
        "role": { "type": "string", "enum": ["client"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "adminNotes": { "type": "string", "maxLength": 4000 },
        "suspensionReason": { "type": "string", "maxLength": 1000 },
        "suspendedAt": { "type": "string", "maxLength": 50 },
        "suspendedBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fileNumber", "fullName", "phone", "email", "gender", "dob", "role", "status"]
    },
    "MemberRecord": {
      "title": "MemberRecord",
      "description": "Individual child clinical report or supplementary sub-file attached to a specific family member in a client file",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientUid": { "type": "string", "maxLength": 128 },
        "familyMemberId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "familyMemberName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "recordCategory": { "type": "string", "enum": ["report", "subfile"] },
        "reportType": {
          "type": "string",
          "enum": [
            "developmental_assessment",
            "aba_progress",
            "speech_therapy",
            "occupational_therapy",
            "iep_plan",
            "medical_file",
            "school_report",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 6000 },
        "recommendations": { "type": "string", "maxLength": 4000 },
        "specialistName": { "type": "string", "maxLength": 150 },
        "reportDate": { "type": "string", "minLength": 4, "maxLength": 30 },
        "fileUrl": { "type": "string", "maxLength": 1000 },
        "fileName": { "type": "string", "maxLength": 250 },
        "authorRole": { "type": "string", "enum": ["admin", "client"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "clientUid",
        "familyMemberId",
        "familyMemberName",
        "recordCategory",
        "reportType",
        "title",
        "summary",
        "reportDate",
        "authorRole",
        "createdByUid"
      ]
    },
    "Specialist": {
      "title": "Specialist",
      "description": "Rehabilitation therapist, psychologist or clinical consultant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "title": { "type": "string" },
        "role": { "type": "string" },
        "category": { "type": "string" },
        "avatar": { "type": "string" },
        "experienceYears": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "bio": { "type": "string" },
        "specialties": { "type": "array" }
      },
      "required": ["id", "name", "title", "role"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Parent review and testimonial for Raba Center services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentName": { "type": "string" },
        "parentNameEn": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "category": { "type": "string" },
        "specialistName": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "avatar": { "type": "string" }
      },
      "required": ["parentName", "rating", "comment"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Clinical and educational article for parents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "categoryTitle": { "type": "string" },
        "readTimeMinutes": { "type": "number" },
        "publishDate": { "type": "string" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "title", "category"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or booking alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrative user record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "operations_manager", "clinical_supervisor", "receptionist", "accountant", "custom", "admin", "clinical_manager"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "assignedBranches": { "type": "array" },
        "branchScope": { "type": "string", "enum": ["all", "assigned_only", "assigned_and_unassigned"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Dynamic site configuration, module customizer data, and page content",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "data": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["data"]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Dynamic site configuration, module customizer data, and page content"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Registered family/client profiles keyed by Firebase Auth UID"
    },
    "/clients/{clientId}/member_records/{recordId}": {
      "schema": "MemberRecord",
      "description": "Subcollection storing separate child clinical reports and sub-files per added family member"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of patient booking requests and appointments"
    },
    "/customer_requests/{requestId}": {
      "schema": "Appointment",
      "description": "Collection of general customer inquiries and newsletter subscriptions"
    },
    "/specialists/{specialistId}": {
      "schema": "Specialist",
      "description": "Collection of certified medical and rehabilitation specialists"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of client reviews and testimonials"
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of educational articles and clinical guides"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of system and appointment notifications"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of administrative users with privileged system access"
    }
  }
}
